@page
@model IndexModel

<h1> Workshop Registration Form</h1>

<p> Please fill out the form below to register for the workshop. </p>

<form method="POST">
    
    First Name: <input type="text" name="fname" required/>
    <br /><br />
    Age: <input type="number" name="age" min="16" max="120" required/>
    <br /><br />
        
    Workshop Type: <select name="workshop" required>
       
            <option value="">Select a workshop</option>
            <option value="Web Development">Web Development</option>
            <option value="Data Science">Data Science</option>
            <option value="Networking">Networking</option>
        </select>
        <br /><br />
      RequiresLaptop? 
      <input type="radio" name="requiresLaptop" value="true" required/> YES<br/>
        <input  type = "radio" name="requiresLaptop" value="false"/> NO<br /><br />
      
    
    <input type="submit" value="Register for workshop"/>
</form> 
<h3>@Model.Message</h3>
