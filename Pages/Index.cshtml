@page
@model IndexModel

<h1> Workshop Registration Form</h1>

<p> Please fill out the form below to register for the workshop. </p>

<form method="post">
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Workshop"></label>
        <select asp-for="Workshop" class="form-control">
            <option value="">Select a workshop</option>
            <option value="Web Development">Web Development</option>
            <option value="Data Science">Data Science</option>
            <option value="Networking">Networking</option>
        </select>
        <span asp-validation-for="Workshop" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="RequiresLaptop" class="form-check-input" />
        <label asp-for="RequiresLaptop" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form> 
